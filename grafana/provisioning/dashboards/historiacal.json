{
  "dashboard": {
    "id": null,
    "title": "Kenya Weather Historical Analysis",
    "tags": ["weather", "kenya", "historical", "climate"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Temperature Trends Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "rawSql": "SELECT timestamp as time, city, temperature FROM weather_data WHERE data_type = 'historical_simulated' ORDER BY timestamp",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "spanNulls": false,
              "showPoints": "never",
              "pointSize": 5
            }
          },
          "overrides": []
        },
        "options": {
          "tooltip": {"mode": "single"},
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      },
      {
        "id": 2,
        "title": "Monthly Rainfall Patterns",
        "type": "barchart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "rawSql": "SELECT month, city, AVG(rainfall_1h) as avg_rainfall FROM weather_data WHERE data_type = 'historical_simulated' GROUP BY month, city ORDER BY month",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 2,
              "fillOpacity": 80,
              "gradientMode": "none",
              "spanNulls": false,
              "showPoints": "never",
              "pointSize": 5
            }
          },
          "overrides": []
        }
      },
      {
        "id": 3,
        "title": "Yearly Temperature Comparison",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 8},
        "targets": [
          {
            "rawSql": "SELECT year, city, AVG(temperature) as avg_temp FROM weather_data WHERE data_type = 'historical_simulated' GROUP BY year, city ORDER BY year",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "continuous-BlPu"},
            "mappings": [],
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "red", "value": 80}
              ]
            },
            "unit": "celsius"
          }
        },
        "options": {
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "textMode": "auto"
        }
      },
      {
        "id": 4,
        "title": "Average Humidity by City",
        "type": "gauge",
        "gridPos": {"h": 6, "w": 6, "x": 6, "y": 8},
        "targets": [
          {
            "rawSql": "SELECT city, AVG(humidity) as avg_humidity FROM weather_data WHERE data_type = 'historical_simulated' GROUP BY city",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 60},
                {"color": "red", "value": 80}
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "auto",
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 5,
        "title": "Rainfall Distribution by Season",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
        "targets": [
          {
            "rawSql": "SELECT \n  CASE \n    WHEN month IN (3,4,5) THEN 'Long Rains (Mar-May)'\n    WHEN month IN (10,11,12) THEN 'Short Rains (Oct-Dec)'\n    ELSE 'Dry Season'\n  END as season,\n  SUM(rainfall_1h) as total_rainfall\nFROM weather_data \nWHERE data_type = 'historical_simulated'\nGROUP BY season",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "displayMode": "pie"
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Wind Speed Trends",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14},
        "targets": [
          {
            "rawSql": "SELECT timestamp as time, city, wind_speed FROM weather_data WHERE data_type = 'historical_simulated' ORDER BY timestamp",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "kms",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 7,
        "title": "City Comparison - Average Metrics",
        "type": "table",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14},
        "targets": [
          {
            "rawSql": "SELECT \n  city,\n  ROUND(AVG(temperature), 2) as avg_temp,\n  ROUND(AVG(humidity), 2) as avg_humidity,\n  ROUND(AVG(rainfall_1h), 2) as avg_rainfall,\n  ROUND(AVG(wind_speed), 2) as avg_wind_speed,\n  COUNT(*) as records\nFROM weather_data \nWHERE data_type = 'historical_simulated'\nGROUP BY city\nORDER BY avg_temp DESC",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "continuous-BlYlRd"},
            "custom": {
              "displayMode": "color-background"
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "avg_temp"},
              "properties": [{"id": "unit", "value": "celsius"}]
            },
            {
              "matcher": {"id": "byName", "options": "avg_humidity"},
              "properties": [{"id": "unit", "value": "percent"}]
            },
            {
              "matcher": {"id": "byName", "options": "avg_rainfall"},
              "properties": [{"id": "unit", "value": "lengthm"}]
            },
            {
              "matcher": {"id": "byName", "options": "avg_wind_speed"},
              "properties": [{"id": "unit", "value": "velocityms"}]
            }
          ]
        }
      },
      {
        "id": 8,
        "title": "Temperature vs Humidity Correlation",
        "type": "scatter",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
        "targets": [
          {
            "rawSql": "SELECT temperature, humidity, city FROM weather_data WHERE data_type = 'historical_simulated' AND timestamp > NOW() - INTERVAL '1 year'",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisPlacement": "auto",
              "pointSize": 5
            }
          }
        },
        "options": {
          "tooltip": {"mode": "single"}
        }
      },
      {
        "id": 9,
        "title": "Monthly Climate Patterns",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
        "targets": [
          {
            "rawSql": "SELECT \n  month,\n  city,\n  AVG(temperature) as avg_temperature\nFROM weather_data \nWHERE data_type = 'historical_simulated'\nGROUP BY month, city\nORDER BY month, city",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "scheme", "scheme": "Blues"},
            "custom": {
              "axisPlacement": "auto",
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              }
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Data Summary Statistics",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 30},
        "targets": [
          {
            "rawSql": "SELECT COUNT(*) as total_records FROM weather_data WHERE data_type = 'historical_simulated'",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "value"},
            "mappings": [],
            "thresholds": {
              "steps": [
                {"color": "green", "value": null}
              ]
            },
            "unit": "none"
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "auto"
        }
      },
      {
        "id": 11,
        "title": "Cities Monitored",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 30},
        "targets": [
          {
            "rawSql": "SELECT COUNT(DISTINCT city) as total_cities FROM weather_data WHERE data_type = 'historical_simulated'",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "value"},
            "mappings": [],
            "thresholds": {
              "steps": [
                {"color": "blue", "value": null}
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "id": 12,
        "title": "Data Time Range",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 30},
        "targets": [
          {
            "rawSql": "SELECT MIN(timestamp) as start_date, MAX(timestamp) as end_date FROM weather_data WHERE data_type = 'historical_simulated'",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "value"},
            "mappings": [],
            "unit": "dateTimeAsSystem"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "auto"
        }
      },
      {
        "id": 13,
        "title": "Average Temperature",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 30},
        "targets": [
          {
            "rawSql": "SELECT AVG(temperature) as avg_temperature FROM weather_data WHERE data_type = 'historical_simulated'",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "value"},
            "mappings": [],
            "unit": "celsius"
          }
        }
      }
    ],
    "time": {
      "from": "now-10y",
      "to": "now"
    },
    "timepicker": {},
    "templating": {
      "list": [
        {
          "name": "city",
          "type": "query",
          "datasource": {
            "type": "postgres",
            "uid": "${datasource}"
          },
          "query": {
            "query": "SELECT DISTINCT city FROM weather_data WHERE data_type = 'historical_simulated' ORDER BY city",
            "refId": "StandardVariableQuery"
          },
          "refresh": 1,
          "includeAll": true,
          "multi": true,
          "allValue": ".*",
          "current": {
            "value": ["$__all"],
            "text": "All",
            "selected": true
          }
        },
        {
          "name": "season",
          "type": "custom",
          "query": "Long Rains,Short Rains,Dry Season,All",
          "includeAll": true,
          "allValue": ".*",
          "multi": false,
          "current": {
            "value": "All",
            "text": "All",
            "selected": true
          }
        }
      ]
    },
    "refresh": "5m",
    "schemaVersion": 37,
    "version": 1,
    "links": []
  },
  "folderTitle": "Weather",
  "message": "Dashboard created from JSON",
  "overwrite": true
}