        {
          "datasource": {
            "type": "postgres",
            "uid": "postgresql"
          },
          "rawSql": "SELECT\n  month,\n  SUM(rainfall_1h) as \"Monthly Rainfall\"\nFROM weather_data\nWHERE city = 'nairobi' AND year = 2024\nGROUP BY month\nORDER BY month",
