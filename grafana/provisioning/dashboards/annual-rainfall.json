    {
      "id": 7,
      "title": "Annual Rainfall Summary",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "postgresql"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgresql"
          },
          "rawSql": "SELECT\n  city as \"City\",\n  SUM(rainfall_1h) as \"Total Rainfall (mm)\",\n  AVG(rainfall_1h) as \"Avg Daily Rainfall (mm)\",\n  MAX(rainfall_1h) as \"Max Daily Rainfall (mm)\",\n  COUNT(CASE WHEN rainfall_1h > 0 THEN 1 END) as \"Rainy Days\",\n  ROUND(COUNT(CASE WHEN rainfall_1h > 0 THEN 1 END) * 100.0 / COUNT(*), 1) as \"Rainy Days %\"\nFROM weather_data\nWHERE year = 2024\nGROUP BY city\nORDER BY \"Total Rainfall (mm)\" DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          }
        }
      }
    }
